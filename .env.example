# ─────────────────────────────────────────────────────────────
# LURIA — variables de entorno de EJEMPLO (sin secretos).
# Copia este archivo a .env.local y completa los valores reales
# solo en el servidor o en el panel del proveedor de hosting.
# Variables NEXT_PUBLIC_* se exponen al navegador: nunca pongas secretos ahí.
# ─────────────────────────────────────────────────────────────

# development | test | production
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BRAND_NAME=LURIA

# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO SERVIDOR. Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Pagos: wompi | mock (solo desarrollo) | mercadopago / payu (adaptador pendiente)
PAYMENT_PROVIDER=mock
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Licencias: pending | manual | http | simulated (solo desarrollo)
LICENSE_ADAPTER=simulated
LICENSE_MANUAL_REVOCATION_CONFIRMED=false
LICENSE_API_BASE_URL=
LICENSE_API_SHARED_SECRET=
# Opción B (propuesta): llave Ed25519 PKCS8 PEM para firmar tokens de licencia
LICENSE_TOKEN_PRIVATE_KEY=
LICENSE_TOKEN_TTL_HOURS=24

# Operación comercial (pendientes: ver docs/matriz-dependencias.md)
RENEWAL_MODE=
SELLER_IDENTITY=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
EXTENSION_INSTALL_URL=
ACTIVATION_SLA_HOURS=
LEGAL_TEXTS_APPROVED=false
PRICE_TAX_TREATMENT_REVIEWED=false
SUPPORTED_ENVIRONMENTS_VERIFIED=false

# Seguridad: consulta de contraseñas filtradas (Have I Been Pwned, k-anonimato). on | off
PASSWORD_BREACH_CHECK=on

# Tareas programadas (vencimientos y recordatorios)
CRON_SECRET=
